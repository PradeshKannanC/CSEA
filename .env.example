# ==============================================================================
# PITCH AND PROSPER by CSEA — Environment Configuration Template
# ==============================================================================
# Copy this file to .env and provide your production environment values.
# NEVER commit .env or any real secrets to source control.

# Database Connection (MySQL 8.0+ / MariaDB 10.4+)
DATABASE_URL=

# Application & Session Secrets (At least 32 random characters in production)
AUTH_SECRET=
SESSION_SECRET=

# Application URLs
APP_URL=
NEXT_PUBLIC_APP_URL=

# Environment & Server
NODE_ENV=
PORT=

# Transactional Email Provider (Resend - Server-side only)
RESEND_API_KEY=
EMAIL_FROM=

# Optional: Distributed Real-Time Clustering / Multi-Instance Deployment
REDIS_URL=

# Rate Limiting Overrides (Optional)
RATE_LIMIT_FORGOT_PW_IP_MAX=

# Initial Administrator Provisioning (Optional, for prisma/seed.ts)
ADMIN_EMAIL=
ADMIN_INITIAL_PASSWORD=
